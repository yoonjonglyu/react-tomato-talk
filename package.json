{
  "name": "react-tomato-talk-monorepo",
  "private": true,
  "version": "2.0.0",
  "description": "Monorepo for react-tomato-talk (Anonymous, Group, Direct, Random Chat SDK & Server)",
  "scripts": {
    "build": "pnpm --filter react-tomato-talk build",
    "build:server": "pnpm --filter @tomato-talk/server build",
    "build:all": "pnpm -r build",
    "dev:server": "pnpm --filter @tomato-talk/server dev",
    "dev:playground": "pnpm --filter playground dev",
    "start:server": "pnpm --filter @tomato-talk/server start",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
